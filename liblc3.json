{
    "name": "liblc3",
    "version": "1.0.1",
    "description": "LC3 (Bluetooth LE Audio) decoder",
    "filters":["lc3dec"],
    "help": "This filter decodes LC3 bitstream files, the codec of Bluetooth LE Audio, using Google's liblc3.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/liblc3.accessor",
    "filter_source":{
        "lc3dec" : "dec_lc3.c"
    },
    "extension":{
      "lc3" : "audio"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1"],
    "patents": {
        "status": "under-review",
        "note": "LC3: licensing through Bluetooth SIG / Fraunhofer",
        "checked": "2026-10-16"
    }
}
